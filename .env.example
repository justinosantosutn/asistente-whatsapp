# Servidor
PORT=3000
TIMEZONE=America/Argentina/Buenos_Aires

# Para el reverse proxy Caddy en producción (deploy/Caddyfile)
DOMAIN=tu-subdominio.duckdns.org

# --- WhatsApp Cloud API (Meta for Developers) ---
# Token que vos inventás para verificar el webhook (cualquier string secreto).
WHATSAPP_VERIFY_TOKEN=elegi-un-string-secreto
# Token de acceso de la app de Meta (temporal de prueba o permanente).
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono de WhatsApp (Phone Number ID), no el número en sí.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# --- Groq (IA gratuita: transcripción, visión, texto) ---
# Obtenido en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# --- Notion ---
# Internal Integration Token, creado en https://www.notion.so/my-integrations
NOTION_TOKEN=
# ID de la base "Repaso de Actividades" (de la URL de la base de datos)
NOTION_ACTIVITIES_DATABASE_ID=
# ID de la base "Gastos Personales"
NOTION_EXPENSES_DATABASE_ID=

# --- Google Calendar (OAuth2) ---
# Credenciales del proyecto en Google Cloud Console (OAuth Client ID de tipo "Desktop app" o "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Generado una sola vez con: npm run oauth:google
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
